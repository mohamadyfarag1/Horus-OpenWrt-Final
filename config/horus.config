CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_h1radio_ti04-708hp=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_curl=y
# CONFIG_PACKAGE_irqbalance is not set
# CONFIG_PACKAGE_luci-app-irqbalance is not set
CONFIG_PACKAGE_kmod-ath=y
# CONFIG_PACKAGE_kmod-ath10k is not set
# CONFIG_PACKAGE_ath10k-firmware-qca4019 is not set
# CONFIG_PACKAGE_kmod-ath10k-ct is not set
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=y
CONFIG_PACKAGE_ath10k-firmware-qca4019-ct=y
# CONFIG_PACKAGE_ath10k-firmware-qca4019-ct-fullall is not set
CONFIG_PACKAGE_kmod-mac80211=y
# Full hostapd/wpa_supplicant. The default for this target is
# wpad-basic-mbedtls, which is built WITHOUT CONFIG_AIRTIME_POLICY, so
# airtime_mode / airtime_update_interval do not exist in the config
# parser. hostapd treats an unknown directive as a fatal error, so the
# HAMax profile cannot enable airtime fairness on a basic build without
# taking the 5 GHz radio down with it. The full variant carries the
# airtime policy parser plus the rest of the hostapd feature set.
# If this tree builds against wolfssl or openssl instead of mbedtls,
# swap the two lines below for the matching wpad-<ssl> variant.
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-basic is not set
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_KERNEL_CFG80211_CERTIFICATION_ONUS=y
CONFIG_ATH_USER_REGD=y
CONFIG_PACKAGE_ATH_USER_REGD=y
CONFIG_MAC80211_USER_REGD=y
CONFIG_KERNEL_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_luci-theme-openwrt-2020=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-samba is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_samba36-server is not set
# CONFIG_PACKAGE_samba4-server is not set
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-urllib=y
CONFIG_PACKAGE_python3-openssl=y
CONFIG_PACKAGE_python3-logging=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-conf=y
