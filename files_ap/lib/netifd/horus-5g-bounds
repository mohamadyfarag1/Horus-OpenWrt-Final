# Horus SuperChannel plan bounds - single source of truth.
#
# Sourced by /lib/netifd/horus_wireless.sh and by the stock netifd scripts
# that need the channel-plan edges. Values MUST match the plan generated by
# scripts/gen_package_patches.py (CHANS = range(24, 201), 5 MHz steps), which
# is what the ath10k driver actually registers. A mismatch here does not fail
# the build - it silently lets hostapd ask for a channel the driver never
# registered, and the radio drops to 20 MHz or refuses to come up at 0 dBm.
#
# 5 GHz: channels 24..200 == 5120..6000 MHz, 5 MHz spacing
# 2.4 GHz: 2312..2682 MHz, 5 MHz spacing (channel numbers are non-contiguous,
#          see _BLOCKS_2G in gen_package_patches.py - only the freq edges are
#          meaningful here)

HORUS_5G_MIN_CHAN=24
HORUS_5G_MAX_CHAN=200

HORUS_5G_MIN_FREQ=5120
HORUS_5G_MAX_FREQ=6000

HORUS_2G_MIN_FREQ=2312
HORUS_2G_MAX_FREQ=2682

# Frequency-list sanitiser bounds. Deliberately wider than the plan: a value
# inside this window is accepted as "plausibly MHz", a value outside it is
# almost certainly a channel number the caller forgot to convert.
HORUS_FREQ_SANE_MIN=2300
HORUS_FREQ_SANE_MAX=6000
