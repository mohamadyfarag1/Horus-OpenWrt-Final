{
	"luci-app-hamax": {
		"description": "Grant access to the HAMax 5 GHz link profile",
		"read": {
			"uci": [ "hamax", "wireless" ],
			"file": {
				"/tmp/hamax.json": [ "read" ],
				"/tmp/hamax.log": [ "read" ],
				"/usr/bin/hamax": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "hamax", "wireless" ],
			"file": {
				"/usr/bin/hamax": [ "exec" ]
			}
		}
	}
}
