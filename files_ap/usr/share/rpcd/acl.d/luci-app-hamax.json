{
	"luci-app-hamax": {
		"description": "Grant access to HAMax protocol settings and state",
		"read": {
			"uci": [ "hamax", "wireless" ],
			"file": {
				"/tmp/hamax.state": [ "read" ],
				"/tmp/hamax.stations": [ "read" ],
				"/tmp/hamax.log": [ "read" ]
			}
		},
		"write": {
			"uci": [ "hamax", "wireless" ],
			"file": {
				"/tmp/hamax.state": [ "write" ],
				"/tmp/hamax.log": [ "write" ],
				"/usr/bin/hamax": [ "exec" ],
				"/bin/sh": [ "exec" ]
			}
		}
	}
}
