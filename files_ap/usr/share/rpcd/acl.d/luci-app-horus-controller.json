{
	"luci-app-horus-controller": {
		"description": "Grant UCI access for horus-controller",
		"read": {
			"uci": [ "horus_controller" ],
			"file": {
				"/tmp/horus_network_state.json": [ "read" ],
				"/tmp/horus_radius.json": [ "read" ],
				"/etc/init.d/horus_controller": [ "read" ]
			},
			"cgi-io": [ "exec" ]
		},
		"write": {
			"uci": [ "horus_controller" ],
			"file": {
				"/tmp/horus_network_state.json": [ "write" ],
				"/tmp/horus_radius.json": [ "write" ],
				"/tmp/horus_ban_cmd.json": [ "write" ],
				"/tmp/horus_wifi_cmd.json": [ "write" ],
				"/etc/init.d/horus_controller": [ "exec" ]
			}
		}
	}
}
