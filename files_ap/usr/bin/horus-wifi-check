#!/bin/sh
# =============================================
# Horus 9200 - Wi-Fi self-check
#
# Every Wi-Fi failure this build has hit was SILENT: a missing firmware
# blob, a channel table patched into a driver that is never compiled, a
# regulatory rule one megahertz too short. None of them announce
# themselves - you only notice a dead radio or a frequency stuck at 0 dBm.
#
# This prints, in one place, the few facts that distinguish those cases.
# It runs at boot into the system log (tag: horus-wifi) and can be run by
# hand over SSH at any time:
#
#     horus-wifi-check
#
# It only reads. It changes nothing.
# =============================================

FWDIR=/lib/firmware/ath10k/QCA4019/hw1.0
PROBLEMS=0

say() {
    echo "$*"
    [ -n "$HORUS_TO_LOG" ] && logger -t horus-wifi "$*"
}

problem() {
    PROBLEMS=$((PROBLEMS + 1))
    say "FAIL: $*"
}

say "===== Horus Wi-Fi self-check ====="

# --- 1. firmware blobs ------------------------------------------------
FW=$(ls "$FWDIR"/firmware-*.bin 2>/dev/null | head -n 1)
if [ -n "$FW" ]; then
    say "firmware      : $(basename "$FW") ($(wc -c < "$FW") bytes)"
    HF=$(md5sum "$FW" | cut -d' ' -f1)
    if [ "$HF" = "5dfb3152796b275349f92684240d9ab4" ]; then
        say "                md5 $HF (matches reference AP)"
    else
        say "                md5 $HF"
        say "                note: reference AP runs 5dfb3152796b275349f92684240d9ab4"
        say "                      (ath10k-firmware-qca4019-ct 2020.11.08). The"
        say "                      68-channel plan is only proven on that blob."
    fi
else
    problem "no firmware-N.bin in $FWDIR - ath10k cannot probe (-12),"
    say "                both radios will stay down. The image was built"
    say "                without ath10k-firmware-qca4019-ct."
fi

# board-2.bin carries the per-band TX power calibration. This is the one
# binary where a wrong file really does produce 0 dBm - so compare it,
# do not just print it. Reference AP (192.168.100.2) value, verified.
if [ -f "$FWDIR/board-2.bin" ]; then
    HB=$(md5sum "$FWDIR/board-2.bin" | cut -d' ' -f1)
    if [ "$HB" = "2bdce2247cda36f0c3884d09b580999d" ]; then
        say "board-2.bin   : $HB (matches reference AP)"
    else
        problem "board-2.bin is NOT the reference calibration."
        say "                have $HB"
        say "                want 2bdce2247cda36f0c3884d09b580999d"
        say "                Wrong calibration means wrong TX power."
    fi
else
    problem "board-2.bin missing - no calibration data, expect 0 dBm."
fi

# --- 2. did the driver actually attach? -------------------------------
if dmesg 2>/dev/null | grep -q "could not probe fw"; then
    problem "ath10k failed to probe. Relevant kernel lines:"
    dmesg | grep -i "ath10k" | tail -n 5 | while read -r l; do say "                $l"; done
fi

PHYS=$(ls /sys/class/ieee80211/ 2>/dev/null | tr '\n' ' ')
if [ -z "$PHYS" ]; then
    problem "no phy registered at all - the Wi-Fi driver did not load."
else
    say "phys          : $PHYS"
fi

# --- 3. regulatory ----------------------------------------------------
if [ -f /lib/firmware/regulatory.db ]; then
    say "regulatory.db : $(wc -c < /lib/firmware/regulatory.db) bytes"
else
    problem "regulatory.db missing - the extended channels stay blocked."
fi
iw reg get 2>/dev/null | grep -E "^(global|country)|@" | while read -r l; do
    say "reg           : $l"
done

# --- 4. per-radio channel census --------------------------------------
# This is the part that catches the 0 dBm class of bug. A channel the UI
# offers but the driver never registered does not appear here at all; a
# channel present but uncalibrated shows up as disabled or 0.0 dBm.
for PHYPATH in /sys/class/ieee80211/*; do
    [ -e "$PHYPATH" ] || continue
    PHY=$(basename "$PHYPATH")
    INFO=$(iw phy "$PHY" info 2>/dev/null)
    [ -n "$INFO" ] || continue

    CHANS=$(echo "$INFO" | grep -c "MHz \[")
    DIS=$(echo "$INFO" | grep "MHz \[" | grep -c "disabled")
    ZERO=$(echo "$INFO" | grep "MHz \[" | grep -c "(0\.0 dBm)")
    LIVE=$((CHANS - DIS))

    say "$PHY          : $CHANS channels, $LIVE usable, $DIS disabled, $ZERO at 0.0 dBm"

    if [ "$ZERO" -gt 0 ]; then
        problem "$PHY has $ZERO channel(s) at 0.0 dBm:"
        echo "$INFO" | grep "MHz \[" | grep "(0\.0 dBm)" | head -n 8 |
            while read -r l; do say "                $l"; done
    fi

    # Driver table vs LuCI dropdown. The 5 GHz driver is meant to expose the
    # full 68-channel plan (999-horus-superchannels.patch). If it exposes far
    # fewer, the channel table was not extended - the UI would then offer
    # channels the driver never registered, and picking one makes hostapd fail
    # to bring the interface up ("Could not determine operating frequency"),
    # which looks exactly like the radio losing all power.
    IS5G=$(echo "$INFO" | grep -c "51[0-9][0-9]\.0 MHz\|52[0-9][0-9]\.0 MHz\|58[0-9][0-9]\.0 MHz")
    if [ "$IS5G" -gt 0 ] && [ "$CHANS" -lt 60 ]; then
        problem "$PHY exposes only $CHANS 5 GHz channels (expected 68)."
        say "                The driver channel table was not extended, so the"
        say "                LuCI list has channels the driver lacks; selecting"
        say "                one will drop the radio. 999-horus-superchannels.patch"
        say "                did not reach the driver that shipped."
    fi
done

# --- 5. link quality on associated links ------------------------------
# A correct channel table does not make the link fast, and the two faults
# that quietly halve it are invisible to every check above.
#
#   * A 2x2 radio that settles on ONE spatial stream (VHT-NSS 1) delivers
#     half the throughput while dmesg, iw reg and the channel census all
#     still say OK.
#   * A receiver driven into compression reads a HUGE signal and a TERRIBLE
#     MCS at the same time. Two of these APs on one bench 30 cm apart at
#     30 dBm arrive at roughly -1 dBm, tens of dB past the front end's
#     limit. The instinct is to raise power, which makes it worse: measured
#     on this hardware, dropping 30 -> 10 dBm took 86 Mbit/s to 127.
#     Anything stronger than about -30 dBm is too hot, not "excellent".
#
# Neither announces itself, and both cost a long investigation the first
# time they are met, so name them explicitly.
for IFACE in $(iw dev 2>/dev/null | sed -n 's/^[[:space:]]*Interface //p'); do
    DUMP=$(iw dev "$IFACE" station dump 2>/dev/null)
    [ -n "$DUMP" ] || continue

    RXR=$(echo "$DUMP" | sed -n 's/.*rx bitrate:[[:space:]]*//p' | head -n 1)
    TXR=$(echo "$DUMP" | sed -n 's/.*tx bitrate:[[:space:]]*//p' | head -n 1)
    say "$IFACE link : rx ${RXR:-unknown}"
    say "                tx ${TXR:-unknown}"

    # How many chains this radio really has (popcount of the antenna mask).
    PHY=$(cat "/sys/class/net/$IFACE/phy80211/name" 2>/dev/null)
    NCHAIN=0
    MASK=$(iw phy "$PHY" info 2>/dev/null |
           sed -n 's/.*Available Antennas: TX \(0x[0-9a-fA-F]*\).*/\1/p' | head -n 1)
    if [ -n "$MASK" ]; then
        M=$(printf '%d' "$MASK" 2>/dev/null || echo 0)
        while [ "$M" -gt 0 ]; do
            NCHAIN=$((NCHAIN + M % 2))
            M=$((M / 2))
        done
    fi

    # Single stream on a multi-chain radio = half the link, silently.
    if [ "$NCHAIN" -ge 2 ] && echo "$RXR$TXR" | grep -q "NSS 1"; then
        problem "$IFACE negotiated ONE spatial stream on a ${NCHAIN}x${NCHAIN} radio."
        say "                That halves the rate on its own. Usual causes: the two"
        say "                ends too close (a pure line-of-sight channel carries"
        say "                only one stream), same-polarity antennas, or one chain"
        say "                far weaker than the other - see the spread below."
    fi

    # Per-chain spread. Chains at/below -80 are unpopulated, not weak.
    # Match on the whole first field, so "signal avg:" and "beacon signal
    # avg:" cannot be picked up instead of the live "signal:" line.
    CHAINS=$(echo "$DUMP" | awk '$1 == "signal:" {
                 s = $0; sub(/.*\[/, "", s); sub(/\].*/, "", s); print s; exit }')
    if [ -n "$CHAINS" ]; then
        SPREAD=$(echo "$CHAINS" | tr ',' '\n' | awk '
            { v = $1 + 0
              if (v > -80) { if (n++ == 0) { lo = v; hi = v }
                             if (v < lo) lo = v
                             if (v > hi) hi = v } }
            END { if (n > 1) print hi - lo; else print 0 }')
        say "                chains [$CHAINS ] spread ${SPREAD} dB"
        if [ "${SPREAD:-0}" -gt 10 ]; then
            problem "$IFACE chain spread is ${SPREAD} dB (want under 10)."
            say "                MIMO needs both chains comparable; this wide a gap"
            say "                pushes the link to a single stream. Move or rotate"
            say "                the unit and re-read: if the spread follows the"
            say "                geometry it is a near-field null, not a fault. If"
            say "                it stays put, swap the two antennas - if the weak"
            say "                chain follows the antenna it is the antenna/cable,"
            say "                if it stays on the same chain it is the board."
        fi
    fi

    # Receiver overload. Strong signal + low MCS is the trap.
    RSSI=$(echo "$DUMP" | awk '$1 == "signal:" { print $2 + 0; exit }')
    if [ -n "$RSSI" ] && [ "$RSSI" -gt -30 ]; then
        problem "$IFACE is receiving at ${RSSI} dBm - too hot, not excellent."
        say "                The front end compresses above roughly -30 dBm, so the"
        say "                MCS collapses while the signal still reads full. LOWER"
        say "                the transmit power (10 dBm is plenty on a bench) or"
        say "                separate the units; raising power makes this worse."
    fi
done

# --- 6. verdict -------------------------------------------------------
if [ "$PROBLEMS" -eq 0 ]; then
    say "result        : OK - no problems found"
else
    say "result        : $PROBLEMS problem(s) found - see FAIL lines above"
fi
say "=================================="

exit 0
