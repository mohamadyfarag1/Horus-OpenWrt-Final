#!/bin/sh
# connect-rocket: Connect Horus IPQ4019 to Ubiquiti Rocket AC / Rocket Prism
# Usage: connect-rocket [SSID] [KEY] [FREQ] [CHAN] [BSSID]
#
# Examples:
#   connect-rocket MyRocket MyPassword 5885
#   connect-rocket OpenRocketNetwork "" 5885 177
#   connect-rocket MyRocket MyPassword 5885 177 B4:FB:E4:BE:D5:D4

SSID="${1:-Rocket-AC}"
KEY="${2:-}"
FREQ="${3:-5885}"
CHAN="${4:-}"
TARGET_BSSID="${5:-}"

# Auto-calculate channel from frequency if not explicitly passed
if [ -z "$CHAN" ] && [ -n "$FREQ" ]; then
    if [ "$FREQ" -ge 5180 ] && [ "$FREQ" -le 6100 ]; then
        CHAN=$(( (FREQ - 5000) / 5 ))
    else
        CHAN=177
    fi
fi
[ -z "$FREQ" ] && FREQ=$(( 5000 + 5 * CHAN ))

# Derive a globally unique Ubiquiti OUI MAC (00:27:22:xx:yy:zz)
# Each physical Horus board keeps its own unique hardware suffix (xx:yy:zz),
# guaranteeing NO MAC collisions even if 100 Horus devices connect to the same Rocket!
BASE_MAC=$(uci -q get wireless.radio1.macaddr)
[ -z "$BASE_MAC" ] && BASE_MAC=$(uci -q get network.lan.macaddr)
[ -z "$BASE_MAC" ] && BASE_MAC=$(cat /sys/class/net/br-lan/address 2>/dev/null)

if [ -n "$BASE_MAC" ]; then
    MAC_SUFFIX=$(echo "$BASE_MAC" | awk -F: '{print $(NF-2)":"$(NF-1)":"$NF}')
    UBNT_STATION_MAC="00:27:22:$MAC_SUFFIX"
else
    UBNT_STATION_MAC="00:27:22:92:00:01"
fi

echo "=========================================================="
echo "  Horus IPQ4019 -> Ubiquiti Rocket AC Connection Setup"
echo "  Target SSID : $SSID"
if [ -n "$TARGET_BSSID" ]; then
    echo "  Target BSSID: $TARGET_BSSID (Locked)"
else
    echo "  Target BSSID: Auto (Any Rocket broadcasting $SSID)"
fi
echo "  Frequency   : $FREQ MHz (Channel $CHAN)"
echo "  Station MAC : $UBNT_STATION_MAC (Unique Ubiquiti OUI)"
echo "  WDS Mode    : Enabled (4-Address mode for airOS bridge)"
echo "  airMAX IE   : Enabled (OUI 00:27:22 airMAX AC signature)"
echo "=========================================================="

# 1. Configure 5 GHz physical radio (radio1)
uci set wireless.radio1.channel="$CHAN"
uci set wireless.radio1.htmode='VHT40'
uci set wireless.radio1.disabled='0'
uci set wireless.radio1.airmax_compat='1'

# 2. Configure Station Interface
uci -q delete wireless.sta_rocket
uci set wireless.sta_rocket=wifi-iface
uci set wireless.sta_rocket.device='radio1'
uci set wireless.sta_rocket.network='wwan'
uci set wireless.sta_rocket.mode='sta'
uci set wireless.sta_rocket.ssid="$SSID"
uci set wireless.sta_rocket.macaddr="$UBNT_STATION_MAC"

if [ -n "$TARGET_BSSID" ]; then
    uci set wireless.sta_rocket.bssid="$TARGET_BSSID"
else
    uci -q delete wireless.sta_rocket.bssid
fi

if [ -n "$KEY" ]; then
    uci set wireless.sta_rocket.encryption='psk2'
    uci set wireless.sta_rocket.key="$KEY"
else
    uci set wireless.sta_rocket.encryption='none'
fi

uci set wireless.sta_rocket.wds='1'
uci set wireless.sta_rocket.airmax_compat='1'

# 3. Configure network interface wwan (DHCP client from Rocket)
uci -q delete network.wwan
uci set network.wwan=interface
uci set network.wwan.proto='dhcp'

# 4. Add wwan to firewall wan zone
uci -q del_list firewall.@zone[1].network='wwan'
uci add_list firewall.@zone[1].network='wwan'

uci commit wireless
uci commit network
uci commit firewall

echo "[*] Configuration committed. Reloading Wi-Fi..."
wifi reload

echo "[*] Injecting Ubiquiti airMAX Vendor Elements..."
(
    sleep 3
    for iface in $(iw dev 2>/dev/null | grep Interface | awk '{print $2}'); do
        case "$iface" in
            *sta*|*wlan*|*wwan*|phy1*)
                wpa_cli -p /var/run/wpa_supplicant -i "$iface" vendor_elem_add 0 dd080027220002040608 2>/dev/null || true
                wpa_cli -p /var/run/wpa_supplicant -i "$iface" vendor_elem_add 11 dd080027220002040608 2>/dev/null || true
            ;;
        esac
    done
) &

echo "=========================================================="
echo "  Setup Complete! Connection is initializing."
echo "  To verify: iw dev | grep -A 10 'type managed'"
echo "  To view live association: logread -f | grep -E '(wpa|wifi|ath10k)'"
echo "=========================================================="
