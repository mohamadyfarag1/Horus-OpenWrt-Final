#!/bin/sh
# connect-nano: Connect Horus IPQ4019 (2.4 GHz) to Ubiquiti NanoStation M2
# Usage: connect-nano [SSID] [KEY] [FREQ] [CHAN] [BSSID]
#
# Examples:
#   connect-nano MyNanoStation MyPassword 2412
#   connect-nano OpenNano "" 2462 11

SSID="${1:-NanoStation-M2}"
KEY="${2:-}"
FREQ="${3:-2412}"
CHAN="${4:-}"
TARGET_BSSID="${5:-}"

# Auto-calculate channel from frequency if not explicitly passed
if [ -z "$CHAN" ] && [ -n "$FREQ" ]; then
    if [ "$FREQ" -ge 2312 ] && [ "$FREQ" -le 2402 ]; then
        CHAN=$(( 256 + (FREQ - 2407) / 5 ))
    elif [ "$FREQ" -eq 2407 ]; then
        CHAN=256
    elif [ "$FREQ" -ge 2412 ] && [ "$FREQ" -le 2472 ]; then
        CHAN=$(( (FREQ - 2407) / 5 ))
    elif [ "$FREQ" -eq 2484 ]; then
        CHAN=14
    elif [ "$FREQ" -eq 2477 ]; then
        CHAN=74
    elif [ "$FREQ" -eq 2482 ]; then
        CHAN=75
    elif [ "$FREQ" -ge 2487 ] && [ "$FREQ" -le 2507 ]; then
        CHAN=$(( 76 + (FREQ - 2487) / 5 ))
    elif [ "$FREQ" -ge 2512 ] && [ "$FREQ" -le 2732 ]; then
        CHAN=$(( (FREQ - 2437) / 5 ))
    else
        CHAN=1
    fi
fi
[ -z "$FREQ" ] && FREQ=2412

# Derive a globally unique Ubiquiti OUI MAC (00:27:22:xx:yy:zz)
# Each physical Horus board keeps its own unique hardware suffix (xx:yy:zz)
BASE_MAC=$(uci -q get wireless.radio0.macaddr)
[ -z "$BASE_MAC" ] && BASE_MAC=$(uci -q get network.lan.macaddr)
[ -z "$BASE_MAC" ] && BASE_MAC=$(cat /sys/class/net/br-lan/address 2>/dev/null)

if [ -n "$BASE_MAC" ]; then
    MAC_SUFFIX=$(echo "$BASE_MAC" | awk -F: '{print $(NF-2)":"$(NF-1)":"$NF}')
    UBNT_STATION_MAC="00:27:22:$MAC_SUFFIX"
else
    UBNT_STATION_MAC="00:27:22:92:00:02"
fi

echo "=========================================================="
echo "  Horus IPQ4019 (2.4 GHz) -> Ubiquiti NanoStation M2 Setup"
echo "  Target SSID : $SSID"
if [ -n "$TARGET_BSSID" ]; then
    echo "  Target BSSID: $TARGET_BSSID (Locked)"
else
    echo "  Target BSSID: Auto (Any NanoStation broadcasting $SSID)"
fi
echo "  Frequency   : $FREQ MHz (Channel $CHAN, HT20)"
echo "  Station MAC : $UBNT_STATION_MAC (Unique Ubiquiti OUI)"
echo "  airMAX Mode : Enabled (Ubiquiti Vendor Elements OUI 00:27:22)"
echo "  WDS Mode    : Enabled (4-Address mode for airOS)"
echo "=========================================================="

# 1. Configure 2.4 GHz physical radio (radio0)
uci set wireless.radio0.channel="$CHAN"
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.airmax_compat='1'

# 2. Configure Station Interface
uci -q delete wireless.sta_nano
uci set wireless.sta_nano=wifi-iface
uci set wireless.sta_nano.device='radio0'
uci set wireless.sta_nano.network='wwan'
uci set wireless.sta_nano.mode='sta'
uci set wireless.sta_nano.ssid="$SSID"
uci set wireless.sta_nano.macaddr="$UBNT_STATION_MAC"

if [ -n "$TARGET_BSSID" ]; then
    uci set wireless.sta_nano.bssid="$TARGET_BSSID"
else
    uci -q delete wireless.sta_nano.bssid
fi

if [ -n "$KEY" ]; then
    uci set wireless.sta_nano.encryption='psk2'
    uci set wireless.sta_nano.key="$KEY"
else
    uci set wireless.sta_nano.encryption='none'
fi

uci set wireless.sta_nano.wds='1'
uci set wireless.sta_nano.airmax_compat='1'

# 3. Configure network interface wwan
uci -q delete network.wwan
uci set network.wwan=interface
uci set network.wwan.proto='dhcp'

# 4. Add wwan to firewall wan zone
uci -q del_list firewall.@zone[1].network='wwan'
uci add_list firewall.@zone[1].network='wwan'

uci commit wireless
uci commit network
uci commit firewall

echo "[*] Configuration committed. Reloading Wi-Fi..."
wifi reload

echo "[*] Injecting Ubiquiti airMAX Vendor Elements for 2.4 GHz..."
(
    sleep 3
    for iface in $(iw dev 2>/dev/null | grep Interface | awk '{print $2}'); do
        case "$iface" in
            *sta*|*wlan*|*wwan*|phy0*|phy1*)
                wpa_cli -p /var/run/wpa_supplicant -i "$iface" vendor_elem_add 0 dd080027220002040608 2>/dev/null || true
                wpa_cli -p /var/run/wpa_supplicant -i "$iface" vendor_elem_add 11 dd080027220002040608 2>/dev/null || true
            ;;
        esac
    done
) &

echo "=========================================================="
echo "  Setup Complete! Waiting for association..."
echo "  To verify: iw dev | grep -A 10 'type managed'"
echo "=========================================================="
