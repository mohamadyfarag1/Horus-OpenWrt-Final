#!/bin/sh
# =====================================================================
# HAMax - Horus AirMax Protocol Engine (Modular CLI Launcher)
# Hardware: IPQ4019 + ath10k-ct + mac80211 + hostapd / wpa_supplicant
# SCOPE: 5 GHz Radio ONLY.
# =====================================================================

HAMAX_LIB="${HAMAX_LIB:-/usr/lib/hamax}"

# Source all modular libraries in order
for mod in "$HAMAX_LIB"/00-common.sh \
           "$HAMAX_LIB"/10-channels.sh \
           "$HAMAX_LIB"/20-radio.sh \
           "$HAMAX_LIB"/30-backup-apply.sh \
           "$HAMAX_LIB"/40-telemetry.sh \
           "$HAMAX_LIB"/50-diagnostics.sh; do
    if [ -r "$mod" ]; then
        . "$mod"
    else
        echo "HAMax Error: module $mod not found!" >&2
        exit 1
    fi
done

# Initialize config and hardware context
hamax_read_config
RADIO=$(hamax_find_radio)

case "$1" in
    enable|apply|status|channels|check|verify)
        hamax_load_phy || true
        hamax_probe_caps
        ;;
    telemetry)
        hamax_probe_caps
        ;;
esac

# CLI Command Dispatcher
case "$1" in
    enable)
        hamax_enable
        ;;
    disable)
        hamax_disable
        ;;
    apply)
        if [ -n "$RADIO" ]; then
            hamax_backup_init
            hamax_apply_radio "$RADIO"
            role=$(hamax_role "$RADIO")
            for iface in $(hamax_ifaces_on_radio "$RADIO"); do
                hamax_apply_iface "$iface" "$role"
            done
            hamax_reload_radio "$RADIO"
            sleep 2
            hamax_write_json
        fi
        ;;
    status)
        hamax_status
        ;;
    telemetry)
        hamax_write_json
        cat "$HAMAX_JSON" 2>/dev/null || true
        ;;
    channels)
        hamax_channels_json
        ;;
    check)
        hamax_check
        ;;
    verify)
        hamax_verify
        ;;
    log-clear)
        : > "$HAMAX_LOG"
        hamax_log "log cleared"
        ;;
    *)
        echo "Usage: hamax {enable|disable|apply|status|telemetry|channels|check|verify|log-clear}"
        exit 1
        ;;
esac
