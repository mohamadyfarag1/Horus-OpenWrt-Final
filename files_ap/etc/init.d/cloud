#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

STATUS_FILE="/tmp/cloud.status"
URL_FILE="/tmp/cloud.url"

start_service() {
    local enabled
    config_load cloud
    config_get enabled main enabled 0

    if [ "$enabled" = "1" ]; then
        echo "🟡 جاري بدء الخدمة..." > "$STATUS_FILE"
        procd_open_instance
        procd_set_param command /usr/bin/cloud-daemon.sh
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    else
        echo "🔴 الخدمة معطلة (Offline)" > "$STATUS_FILE"
        > "$URL_FILE"
    fi
}

stop_service() {
    echo "🔴 الخدمة متوقفة (Offline)" > "$STATUS_FILE"
    > "$URL_FILE"
    killall cloudflared 2>/dev/null
}

service_triggers() {
    procd_add_reload_trigger "cloud"
}

reload_service() {
    stop
    start
}
