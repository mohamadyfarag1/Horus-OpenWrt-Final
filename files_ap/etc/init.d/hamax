#!/bin/sh /etc/rc.common
# HAMax - long-range 5 GHz profile
START=99
STOP=10

start() {
    [ "$(uci -q get hamax.settings.enabled)" = "1" ] || {
        logger -t hamax "HAMax is disabled, not applying the 5 GHz profile"
        return 0
    }
    /usr/bin/hamax enable
}

stop() {
    # Only unwind if we actually applied something, otherwise a plain
    # "stop" on a fresh boot would reload the 5 GHz radio for nothing.
    [ -f /etc/hamax/backup.uci ] || return 0
    /usr/bin/hamax disable
}

reload() {
    [ "$(uci -q get hamax.settings.enabled)" = "1" ] || {
        stop
        return 0
    }
    /usr/bin/hamax enable
}
