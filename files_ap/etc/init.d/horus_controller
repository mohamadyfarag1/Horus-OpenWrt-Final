#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/horus-radius.py

start_service() {
    # Auto-Restore backup if config was wiped by an untracked file copy
    if [ ! -s /etc/config/horus_controller ] || [ "$(uci -q get horus_controller.main.enabled)" = "0" -a -z "$(uci -q get horus_controller.main.base_url)" ]; then
        if [ -s /etc/horus_controller.bak ]; then
            cp -f /etc/horus_controller.bak /etc/config/horus_controller 2>/dev/null
        fi
    fi

    config_load horus_controller
    config_get_bool enabled main enabled 0
    config_get role main role "standalone"
    config_get base_url main base_url ""

    # Auto-Backup valid user configuration
    if [ -n "$base_url" ] || [ "$role" != "standalone" ]; then
        cp -f /etc/config/horus_controller /etc/horus_controller.bak 2>/dev/null
    fi

    if [ "$enabled" -eq 1 ]; then
        # Start RADIUS Sync Daemon
        procd_open_instance "radius"
        procd_set_param command "$PROG"
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    else
        echo '{"status":"disabled","data":[]}' > /tmp/horus_radius.json
        rm -f /tmp/sas_token.txt
    fi
    
    if [ "$role" != "standalone" ]; then
        # Start HMP Controller Daemon
        procd_open_instance "hmp"
        procd_set_param command /usr/bin/horus-hmp.py
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi
}

stop_service() {
    echo '{"status":"disabled","data":[]}' > /tmp/horus_radius.json
    rm -f /tmp/sas_token.txt
}

service_triggers() {
    procd_add_reload_trigger "horus_controller"
}
