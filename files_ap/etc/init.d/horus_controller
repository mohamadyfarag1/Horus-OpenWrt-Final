#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/horus-radius.py

start_service() {
    config_load horus_controller
    config_get_bool enabled main enabled 0

    if ! grep -q "horus_injector.js" /www/luci-static/resources/luci.js 2>/dev/null; then
        [ -x /etc/uci-defaults/99_horus-controller-patch ] && /etc/uci-defaults/99_horus-controller-patch >/dev/null 2>&1
    fi
    chmod +x /www/cgi-bin/* /usr/bin/horus-* /etc/init.d/horus_controller 2>/dev/null

    config_get role main role "standalone"

    if [ "$enabled" -eq 1 ]; then
        # Start RADIUS Sync Daemon
        procd_open_instance "radius"
        procd_set_param command "$PROG"
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    else
        echo '{"status":"disabled","data":[]}' > /tmp/horus_radius.json
        rm -f /tmp/sas_token.txt
    fi
    
    if [ "$role" != "standalone" ]; then
        # Start HMP Controller Daemon
        procd_open_instance "hmp"
        procd_set_param command /usr/bin/horus-hmp.py
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi
}

stop_service() {
    echo '{"status":"disabled","data":[]}' > /tmp/horus_radius.json
    rm -f /tmp/sas_token.txt
}

service_triggers() {
    procd_add_reload_trigger "horus_controller"
}
