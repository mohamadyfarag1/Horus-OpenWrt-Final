#!/bin/sh /etc/rc.common
START=10

boot() {
    . /lib/functions.sh
    local env_part
    env_part="$(find_mtd_part APPSBLENV)"
    [ -n "$env_part" ] || return 0

    RAW_MAC=$(strings "$env_part" | grep -o 'base_mac=[^ ]*' | head -n 1 | cut -d= -f2)
    BASE_MAC=$(echo "$RAW_MAC" | grep -o -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'A-Z' 'a-z' | head -n 1)
    
    if [ -n "$BASE_MAC" ]; then
        ip link set dev eth0 address "$BASE_MAC" 2>/dev/null
    fi
}
