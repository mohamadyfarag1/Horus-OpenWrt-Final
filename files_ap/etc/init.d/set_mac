#!/bin/sh /etc/rc.common
START=10

boot() {
    . /lib/functions.sh
    local env_part
    env_part="$(find_mtd_part APPSBLENV)"
    [ -n "$env_part" ] || return 0

    RAW_MAC=$(cat "$env_part" | tr '\0' '\n' | grep '^base_mac=' | head -n 1 | cut -d= -f2)
    BASE_MAC=$(echo "$RAW_MAC" | grep -o -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'A-Z' 'a-z' | head -n 1)
    
    if [ -n "$BASE_MAC" ]; then
        # Ensure Unicast and Locally Administered if the factory MAC is corrupted (e.g. starts with 01 multicast)
        first_byte=$(echo "$BASE_MAC" | cut -d: -f1)
        # Convert hex to decimal, clear bit 0 (multicast), set bit 1 (locally administered)
        # We can just blindly force it to start with 02 if it's 01
        if [ "$first_byte" = "01" ] || [ "$first_byte" = "00" ]; then
            BASE_MAC="02${BASE_MAC#${first_byte}}"
        fi
        ip link set dev eth0 address "$BASE_MAC" 2>/dev/null
    fi
}
