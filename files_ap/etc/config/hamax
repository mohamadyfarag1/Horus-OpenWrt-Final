
# HAMax - Horus AirMax-Style Long-Range 5 GHz Protocol Profile
# SCOPE: The 5 GHz radio ONLY. The 2.4 GHz radio is never touched by HAMax.

config hamax 'settings'
	option enabled '0'

	# auto | ap | client - "auto" reads the role from the 5 GHz wifi-iface itself
	option mode 'auto'

	# ptmp = tower serving multiple CPEs (RTS on, airtime fairness on)
	# ptp  = single point-to-point backhaul peer (RTS off, airtime fairness off)
	option profile 'ptmp'

	# Leave empty to auto-detect the 5 GHz radio (radio1).
	option radio ''

	# Target Band:
	# radio1 = 5 GHz only (Backhaul to Rocket AC while 2.4 GHz broadcasts normal Wi-Fi)
	# radio0 = 2.4 GHz only (Connection to NanoStation M2)
	# both   = Both 5 GHz and 2.4 GHz
	option target_band 'radio1'
	option priority 'high'
	option ptp_long_range '0'

	# 5 GHz channel: leave empty to use existing configured channel, or choose any channel (5180-5885 MHz).
	option channel ''
	option htmode ''

	# Stop broadcasting SSID in beacons (Stealth)
	option stealth '1'

	# Link length in metres. Drives ACK timeout and slot time.
	option distance '5000'

	option beacon_int '100'
	option dtim_period '1'

	# RTS/CTS threshold in bytes; 0 disables. Forced to 0 for ptp.
	option rts '512'

	# Multicast/broadcast rate in kbps (lifts multicast off 6 Mbit/s floor)
	option mcast_rate '24000'

	# Convert multicast/broadcast to unicast on air (drastically lowers latency and packet loss on PtP/PtMP)
	option multicast_to_unicast '1'

	# Optimize Linux kernel network socket buffers and device backlog for high-throughput aggregated wireless
	option tune_buffers '1'

	# Candela Technologies ath10k-ct firmware optimization (prevents aggressive station drop on fading links)
	option ct_suppress_kick '1'

	# Antenna gain in dBi (e.g. 23 for a 23 dBi dish, empty to leave default)
	option antenna_gain ''

	# Empty leaves the radio's existing txpower alone.
	option txpower ''

	option short_gi '1'
	option noscan '0'
	option disable_legacy_rates '1'
	option wds '1'

	# Airtime fairness (ATF dynamic scheduler)
	option airtime '1'
	option airtime_mode '2'
	option airtime_update_interval '200'

	# HAMax vendor IE in beacons and probe responses.
	option vendor_ie '1'

	# Ubiquiti airMAX Interoperability (OUI 00:27:22 injection for Rocket AC / airMAX APs)
	option airmax_compat '1'

