
# HAMax - long-range profile for the 5 GHz radio.
# The 2.4 GHz radio is never touched by this configuration.

config hamax 'settings'
	option enabled '0'

	# auto | ap | client - "auto" reads the role from the 5 GHz
	# wifi-iface itself instead of restructuring it.
	option mode 'auto'

	# A tuning preset, NOT an association limit. Picking ptp does not
	# stop a second station from associating; it only tells HAMax to
	# tune the radio on the assumption that there is one peer. Use
	# maxassoc and a maclist in /etc/config/wireless to cap the count.
	#   ptmp = tower serving several CPEs (RTS on, airtime fairness on)
	#   ptp  = single backhaul peer (RTS off, airtime fairness off)
	option profile 'ptmp'

	# Leave empty to auto-detect the 5 GHz radio. A value here is
	# rejected unless that radio really is 5 GHz.
	option radio ''

	# 5 GHz channel from the unlocked 10 MHz-spaced plan (5180-5885 MHz).
	# Empty leaves whatever /etc/config/wireless already pins. A channel
	# outside the plan, or one the running driver does not offer, is
	# refused and logged rather than applied blindly.
	#
	# Channels outside the 25 standard 802.11 centres are "off-grid": a
	# stock client never tunes its receiver there while scanning, so the
	# network does not appear in its list at all. That is the only
	# airMAX-style invisibility mechanism this hardware can reproduce -
	# ath10k has no 5/10 MHz channel width support.
	option channel ''
	option htmode ''

	# Stop broadcasting the SSID. Weak on its own; meaningful only in
	# combination with an off-grid channel.
	option stealth '0'

	# Link length in metres. Drives ACK timeout and slot time.
	option distance '5000'

	option beacon_int '100'
	option dtim_period '1'

	# RTS/CTS threshold in bytes; 0 disables. Forced to 0 for ptp.
	option rts '512'

	# Multicast/broadcast rate in kbps - keeps multicast off the
	# 6 Mbit/s floor, which dominates airtime on a PtMP cell.
	option mcast_rate '24000'

	# Empty leaves the radio's existing txpower alone.
	option txpower ''

	option short_gi '1'
	option noscan '1'
	option disable_legacy_rates '1'
	option wds '1'

	# Airtime fairness. Requires a full hostapd build; the engine
	# probes for it and skips it when absent. Forced off for ptp.
	option airtime '1'
	option airtime_mode '2'
	option airtime_update_interval '200'

	# HAMax vendor IE (OUI 00:07:89) in beacons and probe responses.
	option vendor_ie '1'
