config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/a000000.wifi'
	option channel '1'
	option band '2g'
	option htmode 'HT20'
	option disabled '0'
	option country 'YE'
	option country_ie '0'
	option txpower '23'
	option cell_density '0'
	option airmax_compat '1'
	option noscan '1'
	option short_gi_20 '1'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Horus-2.4'
	option encryption 'none'
	option multicast_to_unicast '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/a800000.wifi'
	option band '5g'
	# Explicit non-DFS default. Without this the radio falls back to
	# "auto" (ACS), which can land on a DFS channel (60s radar check
	# before it may beacon) or on an uncalibrated frequency, which the
	# driver reports as 0 dBm.
	option channel '36'
	option htmode 'VHT80'
	option disabled '0'
	option country 'YE'
	option country_ie '0'
	option doth '0'
	option txpower '23'
	option cell_density '0'
	option airmax_compat '1'
	option noscan '1'
	option short_gi_80 '1'
	option short_gi_40 '1'
	option short_gi_20 '1'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Horus-SEND'
	option encryption 'none'
	option wds '1'
	option multicast_to_unicast '1'
	# Prevents netifd reload cascade when WDS station disconnects.
	# Without this, phy1-ap0.sta1 removal triggers bridge STP reconfiguration
	# → phy1-ap0 disabled state → netifd wifi reload → hostapd HT_SCAN → auth timeouts.
	option wds_bridge 'br-lan'
