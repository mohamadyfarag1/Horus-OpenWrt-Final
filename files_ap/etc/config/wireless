config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/a000000.wifi'
	option channel '1'
	option band '2g'
	option htmode 'HT20'
	option txpower '24'
	option country 'BZ'
	option country_ie '0'
	option ldpc '1'
	option rx_stbc '1'
	option tx_stbc '1'
	option short_preamble '1'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Horus-2.4'
	option encryption 'none'
	option wmm '1'
	option dtim_period '1'

