#!/bin/sh
# =============================================
# Horus 9200 - First Boot MAC & Wireless Defaults
# =============================================
. /lib/functions.sh
. /lib/functions/system.sh

ENV_PART="$(find_mtd_part APPSBLENV)"
[ -z "$ENV_PART" ] && exit 0

# Extract MAC using strings or cat/tr fallback
RAW_MAC=$(strings "$ENV_PART" 2>/dev/null | grep -o 'base_mac=[^ ]*' | head -n 1 | cut -d= -f2)
BASE_MAC=$(echo "$RAW_MAC" | grep -o -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'A-Z' 'a-z' | head -n 1)

if [ -z "$BASE_MAC" ]; then
    RAW_MAC2=$(cat "$ENV_PART" | tr '\0' '\n' | grep '^base_mac=' | head -n 1 | cut -d= -f2)
    BASE_MAC=$(echo "$RAW_MAC2" | grep -o -E '([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}' | tr 'A-Z' 'a-z' | head -n 1)
fi

if [ -z "$BASE_MAC" ]; then
    # Silent failure here is what produced the bogus 00:55:55:55:55:55
    # BSSID: with no macaddr set in UCI the radios fall back to the MAC
    # baked into the ath10k board calibration blob. Make it visible.
    logger -t horus-mac "could not read base_mac from $ENV_PART - radios will fall back to the MAC inside board-2.bin"
    exit 0
fi

# Manufacturer OUI is 00:07:89 (Allradio/Dongwon/Horus)
case "$BASE_MAC" in
    0[0-9a-f]:07:89:*|[0-9a-f][0-9a-f]:07:89:*)
        BASE_MAC="00:${BASE_MAC#*:}"
        ;;
    *)
        # Fix corrupted/multicast factory MAC (bit0 must be 0 for Unicast)
        first_byte=$(echo "$BASE_MAC" | cut -d: -f1)
        first_dec=$(printf "%d" "0x${first_byte}" 2>/dev/null || echo "0")
        if [ $(( first_dec & 1 )) -eq 1 ]; then
            new_first=$(printf "%02x" $(( first_dec & 0xFE )))
            BASE_MAC="${new_first}${BASE_MAC#${first_byte}}"
        fi
        ;;
esac

# Derive unique MACs
MAC_LAN=$BASE_MAC
MAC_WAN=$(macaddr_add "$BASE_MAC" 1)
MAC_WIFI2G=$(macaddr_add "$BASE_MAC" 2)
MAC_WIFI5G=$(macaddr_add "$BASE_MAC" 3)

# Apply Network MACs
uci set network.lan.macaddr="$MAC_LAN"
uci set network.wan.macaddr="$MAC_WAN"

# DSA Bridge (br-lan) device MAC configuration
for i in $(seq 0 10); do
    name=$(uci -q get network.@device[$i].name)
    if [ "$name" = "br-lan" ]; then
        uci set network.@device[$i].macaddr="$MAC_LAN"
        break
    fi
done
uci commit network

# Apply Wireless Defaults (Enabled by default, 30 dBm, Country YE like Golden Router, Default Channels)
uci -q delete wireless.radio0.country_ie
uci -q delete wireless.radio1.country_ie

uci set wireless.radio0.disabled='0'
uci set wireless.radio0.channel='1'
uci set wireless.radio0.htmode='HT20'
uci set wireless.radio0.country='YE'
uci set wireless.radio0.txpower='30'
uci set wireless.radio0.macaddr="$MAC_WIFI2G"
uci set wireless.default_radio0.macaddr="$MAC_WIFI2G"

uci set wireless.radio1.disabled='0'
uci set wireless.radio1.channel='36'
uci set wireless.radio1.htmode='VHT80'
uci set wireless.radio1.country='YE'
uci set wireless.radio1.country_ie='0'
uci set wireless.radio1.doth='0'
uci set wireless.radio1.txpower='30'
uci set wireless.radio1.airmax_compat='1'
uci set wireless.radio1.macaddr="$MAC_WIFI5G"
uci set wireless.default_radio1.macaddr="$MAC_WIFI5G"

uci commit wireless

exit 0
