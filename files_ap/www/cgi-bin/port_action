#!/bin/sh
# Horus Port Control CGI handler
echo "Content-Type: application/json"
echo ""

case "$REQUEST_METHOD" in
    GET|POST)
        if [ "$QUERY_STRING" = "action=status" ]; then
            /usr/bin/port_control status
        else
            port=$(echo "$QUERY_STRING" | grep -o 'port=[^&]*' | cut -d= -f2)
            action=$(echo "$QUERY_STRING" | grep -o 'action=[^&]*' | cut -d= -f2)
            if [ -n "$port" ] && [ -n "$action" ]; then
                res=$(/usr/bin/port_control set "$port" "$action" 2>&1)
                echo "{\"result\": \"ok\", \"message\": \"$res\"}"
            else
                echo '{"result": "error", "message": "missing params"}'
            fi
        fi
        ;;
    *)
        echo '{"result": "error", "message": "method not allowed"}'
        ;;
esac
