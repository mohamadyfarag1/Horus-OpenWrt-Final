#!/usr/bin/python3
# -*- coding: utf-8 -*-
import os
import sys
import json
import subprocess

CONFIG_FILE = "/etc/config/horus_groups"

def init_config():
    if not os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "w") as f:
            f.write("config horus_groups 'main'\n")

def get_uci_list(section, option):
    try:
        out = subprocess.check_output(f"uci -q get horus_groups.{section}.{option}", shell=True, text=True).strip()
        return out.split() if out else []
    except Exception:
        return []

def get_uci_option(section, option, default=""):
    try:
        out = subprocess.check_output(f"uci -q get horus_groups.{section}.{option}", shell=True, text=True).strip()
        return out if out else default
    except Exception:
        return default

def get_all_groups():
    groups = {}
    try:
        out = subprocess.check_output("uci -q show horus_groups", shell=True, text=True)
        for line in out.splitlines():
            line = line.strip()
            if not line or '=' not in line:
                continue
            key, val = line.split('=', 1)
            val = val.strip("'").strip()
            parts = key.split('.')
            if len(parts) >= 3 and parts[1] != 'main':
                g_id = parts[1]
                prop = parts[2]
                if g_id.startswith('group_'):
                    if g_id not in groups:
                        groups[g_id] = {"id": g_id, "name": "", "ssid": "", "password": "", "encryption": "psk2", "band": "both"}
                    groups[g_id][prop] = val
    except Exception:
        pass
    return list(groups.values())

def get_assignments():
    assignments = {}
    try:
        out = subprocess.check_output("uci -q show horus_groups", shell=True, text=True)
        for line in out.splitlines():
            line = line.strip()
            if '=' not in line: continue
            key, val = line.split('=', 1)
            val = val.strip("'").strip()
            parts = key.split('.')
            if len(parts) >= 3 and parts[1].startswith('assign_'):
                mac = parts[1].replace('assign_', '').replace('_', ':')
                if parts[2] == 'group_id':
                    assignments[mac.upper()] = val
    except Exception:
        pass
    return assignments

def apply_group_config(group_id, ssid, password, encryption, band="both"):
    assignments = get_assignments()
    target_macs = [mac for mac, gid in assignments.items() if gid == group_id]
    if not target_macs:
        return

    # Write to WIFI_CMD_FILE for root.py to pick up
    cmd = {
        "target_ap": target_macs,
        "iface": "ALL",
        "action": "apply_profile",
        "ssid": ssid,
        "password": password,
        "encryption": encryption,
        "band": band
    }
    with open("/tmp/horus_wifi_cmd.json", "w") as f:
        json.dump(cmd, f)

def main():
    print("Content-Type: application/json\r\n")
    init_config()
    
    method = os.environ.get("REQUEST_METHOD", "GET")
    
    if method == "GET":
        groups = get_all_groups()
        assignments = get_assignments()
        print(json.dumps({"groups": groups, "assignments": assignments}))
        return

    if method == "POST":
        try:
            length = int(os.environ.get('CONTENT_LENGTH', '0'))
            body = sys.stdin.read(length)
            data = json.loads(body)
            action = data.get("action")
            
            if action == "create_group":
                g_id = "group_" + str(int(time.time()))
                name = data.get("name", "New Group")
                ssid = data.get("ssid", "")
                password = data.get("password", "")
                encryption = data.get("encryption", "psk2")
                band = data.get("band", "both")
                
                subprocess.run(f"uci set horus_groups.{g_id}=group", shell=True)
                subprocess.run(f"uci set horus_groups.{g_id}.name='{name}'", shell=True)
                subprocess.run(f"uci set horus_groups.{g_id}.ssid='{ssid}'", shell=True)
                subprocess.run(f"uci set horus_groups.{g_id}.password='{password}'", shell=True)
                subprocess.run(f"uci set horus_groups.{g_id}.encryption='{encryption}'", shell=True)
                subprocess.run(f"uci set horus_groups.{g_id}.band='{band}'", shell=True)
                subprocess.run("uci commit horus_groups", shell=True)
                
                print(json.dumps({"status": "ok", "group_id": g_id}))
            
            elif action == "update_group":
                g_id = data.get("group_id")
                if g_id:
                    name = data.get("name")
                    ssid = data.get("ssid")
                    password = data.get("password")
                    encryption = data.get("encryption")
                    band = data.get("band")
                    
                    if name is not None: subprocess.run(f"uci set horus_groups.{g_id}.name='{name}'", shell=True)
                    if ssid is not None: subprocess.run(f"uci set horus_groups.{g_id}.ssid='{ssid}'", shell=True)
                    if password is not None: subprocess.run(f"uci set horus_groups.{g_id}.password='{password}'", shell=True)
                    if encryption is not None: subprocess.run(f"uci set horus_groups.{g_id}.encryption='{encryption}'", shell=True)
                    if band is not None: subprocess.run(f"uci set horus_groups.{g_id}.band='{band}'", shell=True)
                    subprocess.run("uci commit horus_groups", shell=True)
                    
                    if band is None: band = get_uci_option(g_id, "band", "both")
                    apply_group_config(g_id, ssid, password, encryption, band)
                    
                print(json.dumps({"status": "ok"}))

            elif action == "delete_group":
                g_id = data.get("group_id")
                if g_id:
                    subprocess.run(f"uci delete horus_groups.{g_id}", shell=True)
                    assignments = get_assignments()
                    for mac, ag_id in assignments.items():
                        if ag_id == g_id:
                            sec = "assign_" + mac.replace(":", "_")
                            subprocess.run(f"uci delete horus_groups.{sec}", shell=True)
                    subprocess.run("uci commit horus_groups", shell=True)
                print(json.dumps({"status": "ok"}))

            elif action == "assign_ap":
                macs = data.get("macs", [])
                g_id = data.get("group_id")
                if not isinstance(macs, list):
                    macs = [macs]
                
                for mac in macs:
                    mac = mac.upper()
                    sec = "assign_" + mac.replace(":", "_")
                    if g_id:
                        subprocess.run(f"uci set horus_groups.{sec}=assign", shell=True)
                        subprocess.run(f"uci set horus_groups.{sec}.group_id='{g_id}'", shell=True)
                    else:
                        subprocess.run(f"uci -q delete horus_groups.{sec}", shell=True)
                subprocess.run("uci commit horus_groups", shell=True)
                
                if g_id:
                    ssid = get_uci_option(g_id, "ssid")
                    password = get_uci_option(g_id, "password")
                    encryption = get_uci_option(g_id, "encryption", "psk2")
                    band = get_uci_option(g_id, "band", "both")
                    
                    cmd = {
                        "target_ap": macs,
                        "iface": "ALL",
                        "action": "apply_profile",
                        "ssid": ssid,
                        "password": password,
                        "encryption": encryption,
                        "band": band
                    }
                    with open("/tmp/horus_wifi_cmd.json", "w") as f:
                        json.dump(cmd, f)
                        
                print(json.dumps({"status": "ok"}))
                
        except Exception as e:
            print(json.dumps({"status": "error", "message": str(e)}))

if __name__ == "__main__":
    import time
    main()
